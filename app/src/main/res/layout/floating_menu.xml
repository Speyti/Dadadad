<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0D1B2A"
    android:padding="12dp">

    <!-- Верхняя панель (за неё таскаем) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <!-- Робот слева сверху, как на скрине -->
        <ImageView
            android:id="@+id/robotImage"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/robot_img"
            android:scaleType="centerCrop"
            android:layout_alignParentStart="true" />

        <!-- Заголовок по центру верхней панели -->
        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Functions"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:fontFamily="monospace"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"/>

        <!-- Крестик справа -->
        <TextView
            android:id="@+id/closeBtn"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:gravity="center"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Линия под заголовком -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#8A9CF5"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="-20dp"
        android:layout_marginStart="90dp"
        android:layout_marginEnd="50dp" />

    <!-- Основная часть -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Левая колонка: Категории (под роботом) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView android:id="@+id/catControl" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Control" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="18sp" android:padding="8dp" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/catAssistant" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Assistant" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="18sp" android:padding="8dp" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/catFunctions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Functions" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="18sp" android:padding="8dp" android:background="#8A9CF5" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/catAutomation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Automation" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="18sp" android:padding="8dp" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/catSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Settings" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="18sp" android:padding="8dp" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/catInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="information" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="18sp" android:padding="8dp" />
        </LinearLayout>

        <!-- Правая колонка: Функции (Темная плашка) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#121A24"
            android:padding="8dp"
            android:gravity="end">

            <!-- Плашка для названия функции (пустота) -->
            <TextView
                android:id="@+id/funcName"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Кнопки Tap (прижаты вправо) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button android:id="@+id/btnTap1" android:layout_width="100dp" android:layout_height="44dp" android:text="Tap" android:textColor="#0D1B2A" android:fontFamily="monospace" android:textStyle="bold" android:backgroundTint="#8A9CF5" android:layout_marginBottom="12dp"/>
                <Button android:id="@+id/btnTap2" android:layout_width="100dp" android:layout_height="44dp" android:text="Tap" android:textColor="#0D1B2A" android:fontFamily="monospace" android:textStyle="bold" android:backgroundTint="#8A9CF5" android:layout_marginBottom="12dp"/>
                <Button android:id="@+id/btnTap3" android:layout_width="100dp" android:layout_height="44dp" android:text="Tap" android:textColor="#0D1B2A" android:fontFamily="monospace" android:textStyle="bold" android:backgroundTint="#8A9CF5" android:layout_marginBottom="12dp"/>
                <Button android:id="@+id/btnTap4" android:layout_width="100dp" android:layout_height="44dp" android:text="Tap" android:textColor="#0D1B2A" android:fontFamily="monospace" android:textStyle="bold" android:backgroundTint="#8A9CF5" android:layout_marginBottom="12dp"/>
                <Button android:id="@+id/btnTap5" android:layout_width="100dp" android:layout_height="44dp" android:text="Tap" android:textColor="#0D1B2A" android:fontFamily="monospace" android:textStyle="bold" android:backgroundTint="#8A9CF5" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
