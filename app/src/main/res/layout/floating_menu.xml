<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="410dp"
    android:layout_height="300dp"
    android:orientation="vertical"
    android:background="#0D1B2A"
    android:padding="8dp">

    <!-- Верхняя панель -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Functions"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="monospace"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/closeBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:gravity="center"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#8A9CF5"
        android:layout_marginBottom="8dp" />

    <!-- Основная часть -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Левая колонка: Робот и Категории -->
        <LinearLayout
            android:layout_width="105dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <!-- Робот теперь над категориями -->
            <ImageView
                android:id="@+id/robotImage"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/robot_img"
                android:scaleType="centerCrop"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center_horizontal"/>

            <!-- Категории (текст всегда белый) -->
            <TextView android:id="@+id/catControl" android:layout_width="match_parent" android:layout_height="30dp" android:text="Control" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="12sp" android:gravity="center_vertical" android:paddingStart="4dp" android:background="#1A2B3C" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/catAssistant" android:layout_width="match_parent" android:layout_height="30dp" android:text="Assistant" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="12sp" android:gravity="center_vertical" android:paddingStart="4dp" android:background="#1A2B3C" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/catFunctions" android:layout_width="match_parent" android:layout_height="30dp" android:text="Functions" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="12sp" android:gravity="center_vertical" android:paddingStart="4dp" android:background="#8A9CF5" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/catAutomation" android:layout_width="match_parent" android:layout_height="30dp" android:text="Automation" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="12sp" android:gravity="center_vertical" android:paddingStart="4dp" android:background="#1A2B3C" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/catSettings" android:layout_width="match_parent" android:layout_height="30dp" android:text="Settings" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="12sp" android:gravity="center_vertical" android:paddingStart="4dp" android:background="#1A2B3C" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/catInfo" android:layout_width="match_parent" android:layout_height="30dp" android:text="information" android:textColor="#FFFFFF" android:fontFamily="monospace" android:textSize="11sp" android:gravity="center_vertical" android:paddingStart="4dp" android:background="#1A2B3C" />
        </LinearLayout>

        <!-- Правая колонка: Функции -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#121A24"
            android:padding="8dp">

            <!-- Строка функции 1 (Mouse) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/funcName1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="18sp" android:fontFamily="monospace" />
                <Button android:id="@+id/btnTap1" android:layout_width="44dp" android:layout_height="30dp" android:text="Tap" android:textColor="#0D1B2A" android:fontFamily="monospace" android:textStyle="bold" android:textSize="10sp" android:backgroundTint="#8A9CF5" android:padding="0dp"/>
            </LinearLayout>

            <!-- Строка функции 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/funcName2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="18sp" android:fontFamily="monospace" />
                <Button android:id="@+id/btnTap2" android:layout_width="44dp" android:layout_height="30dp" android:text="Tap" android:textColor="#0D1B2A" android:fontFamily="monospace" android:textStyle="bold" android:textSize="10sp" android:backgroundTint="#8A9CF5" android:padding="0dp"/>
            </LinearLayout>

            <!-- Строка функции 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/funcName3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="18sp" android:fontFamily="monospace" />
                <Button android:id="@+id/btnTap3" android:layout_width="44dp" android:layout_height="30dp" android:text="Tap" android:textColor="#0D1B2A" android:fontFamily="monospace" android:textStyle="bold" android:textSize="10sp" android:backgroundTint="#8A9CF5" android:padding="0dp"/>
            </LinearLayout>

            <!-- Строка функции 4 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/funcName4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="18sp" android:fontFamily="monospace" />
                <Button android:id="@+id/btnTap4" android:layout_width="44dp" android:layout_height="30dp" android:text="Tap" android:textColor="#0D1B2A" android:fontFamily="monospace" android:textStyle="bold" android:textSize="10sp" android:backgroundTint="#8A9CF5" android:padding="0dp"/>
            </LinearLayout>

            <!-- Строка функции 5 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/funcName5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="18sp" android:fontFamily="monospace" />
                <Button android:id="@+id/btnTap5" android:layout_width="44dp" android:layout_height="30dp" android:text="Tap" android:textColor="#0D1B2A" android:fontFamily="monospace" android:textStyle="bold" android:textSize="10sp" android:backgroundTint="#8A9CF5" android:padding="0dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
